{
  "schemaVersion": 1,
  "appliesTo": {
    "packageName": "worde.com",
    "versionName": "1.0.0",
    "versionCode": 1
  },
  "createApp": {
    "defaultLanguage": "pt-BR",
    "name": "Worde: Aprenda Palavras",
    "type": "game",
    "price": "free",
    "acceptDeveloperProgramPolicies": true,
    "acceptUsExportLaws": true,
    "acceptPlayAppSigning": true
  },
  "storeSettings": {
    "category": "GAME_WORD",
    "initialCountry": "BR",
    "supportedFormFactors": [
      "phone",
      "tablet"
    ],
    "untestedFormFactorsDisabled": [
      "wearOs",
      "androidTv",
      "automotive",
      "xr",
      "playGamesPc"
    ]
  },
  "appContent": {
    "privacyPolicyRequired": true,
    "containsAds": true,
    "appAccess": "all_functionality_available_without_special_access",
    "targetAgeGroups": [
      "13-15",
      "16-17",
      "18+"
    ],
    "designedForChildren": false,
    "dataCollected": true,
    "dataShared": true,
    "dataTransmittedOffDevice": true,
    "accountCreation": false,
    "accountDeletionUrlApplicable": false,
    "usesAdvertisingId": true,
    "financialFeatures": false,
    "healthFeatures": false,
    "governmentAppOrInformation": false,
    "newsOrMagazine": false,
    "covidContactTracingOrStatus": false,
    "highRiskOrSensitivePermissions": false,
    "realMoneyGambling": false,
    "userGeneratedContent": false,
    "userCommunication": false,
    "dating": false,
    "inAppPurchases": false,
    "subscriptions": false
  },
  "contentRating": {
    "questionnaireType": "game",
    "declareMildTextReferences": [
      "conflict",
      "death",
      "alcohol"
    ],
    "imagesOrGameplayForThoseReferences": false,
    "acceptIarcCalculatedRating": true
  },
  "release": {
    "artifact": "build/app/outputs/bundle/release/app-release.aab",
    "firstTrack": "internal_testing",
    "playAppSigning": true,
    "uploadKeyIsNotDistributionKey": true
  },
  "ownerSuppliedFields": [
    "accountType",
    "developerDisplayName",
    "legalIdentityAndAddress",
    "verifiedPrivateAccountEmail",
    "verifiedPrivateAccountPhone",
    "publicDeveloperEmail",
    "publicDeveloperPhoneIfOrganization",
    "organizationContactEmailAndPhoneIfOrganization",
    "supportContactEmail",
    "privacyContactEmail",
    "developerWebsiteUrl",
    "supportPageUrl",
    "privacyPolicyUrl",
    "dunsIfOrganization",
    "physicalDeviceVerificationIfRequired",
    "playConsoleAccess"
  ]
}
